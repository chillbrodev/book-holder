# Shared by api/, packages/play-importer/ and infra/cockroachdb/ — this file lives at the REPO ROOT.
# api/ reads it via ../.env, which is why its deno tasks grant --allow-read=../.env.
#
# Required (no defaults): COCKROACHDB_URL, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# POLLY_CACHE_BUCKET. Everything else below has a working default and only needs setting to override.

COCKROACHDB_URL=                # from the CockroachDB Cloud Console. The importer and migrator read this too
PORT=                           # api — defaults to 8000 if unset
DENO_ENV=                       # api — "production" tightens auth cookie flags (Secure/SameSite=None); unset/anything else = local dev
ALLOWED_ORIGIN=                 # api — CORS origin allowed to send credentialed requests; defaults to http://localhost:5173 (Vite)
SESSION_TTL_DAYS=               # api — auth session cookie lifetime; defaults to 30
AWS_REGION=                     # e.g. us-west-2. Must be a region where Polly neural, Transcribe streaming and Bedrock are all available

# Local dev only. These are NOT read by configClient — the AWS SDK's own credential provider chain picks
# them up, which is why they appear nowhere in the code. In production they are deliberately UNSET: the ECS
# task role supplies credentials to the identical client code, so nothing here ships to the container.
#
# The AWS SDK cannot consume an `aws login`/SSO session — that credential type isn't in its provider chain,
# so a permanent key really is needed locally. `./infra/aws/create-dev-user.sh` provisions a scoped IAM user
# with exactly the grants this app makes; see infra/aws/README.md for the trade-off.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# All three model ids have working defaults in api/src/clients/config-client/configClient.ts, so they only
# need setting to override. Changing one is two files, not one string: the model must also be granted in
# infra/aws/task-role-policy.sh AND infra/aws/create-dev-user.sh, in the ARN shape its routing requires —
# a geo-profile model needs the inference-profile ARN plus foundation-model ARNs in every region it routes to.
BEDROCK_MODEL_ID_COMPARISON=     # api — per-beat semantic comparison; defaults to us.amazon.nova-micro-v1:0. The "us." geo-profile prefix is required: Nova Micro has no in-region presence in us-west-2
BEDROCK_MODEL_ID_AGENT=          # api — the tool-calling coach agent; defaults to us.amazon.nova-lite-v1:0. Same "us." geo-profile rule as above
BEDROCK_MODEL_ID_EMBEDDING=      # api — beat and mistake vectors; defaults to amazon.titan-embed-text-v2:0. In-region with no inference profile, so ONE bare foundation-model ARN — the opposite shape to Nova, don't pattern-match them
S3_RECORDINGS_BUCKET=            # unused, and deliberately so — the app does not record your voice. Mic audio is
                                 # transcribed in flight and never stored; the `recordings` table and this var are
                                 # a deferred feature, not a missing config. See docs/OPEN_ITEMS.md §1e
POLLY_CACHE_BUCKET=              # api — S3 bucket for cached line audio, keyed {play}/{character}/{blockId}__{voiceId}__{engine}.mp3; see infra/aws/README.md
POLLY_DEFAULT_VOICE_ID=          # api — fallback voice for a character with no characters.polly_voice_id set; defaults to Brian
