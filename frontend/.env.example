# Vite reads THIS file (frontend/.env) and nothing else. The API has its own, api/.env,
# which the migrator and importer also read; there is no repo-root .env. Vars must start
# with VITE_ or Vite will not expose them, and everything here is compiled into the bundle
# and served to every visitor.

VITE_API_BASE_URL=http://0.0.0.0:8000

# The same Supabase project the API verifies tokens against (api/.env's SUPABASE_URL).
# Two different projects is the failure worth knowing about: sign-in succeeds, the app looks
# signed in, and every call to the API comes back 401 because the token was minted by an
# issuer it doesn't accept.
VITE_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_… / the legacy anon key), never the sb_secret_… one.
# This ships in the JavaScript bundle; a secret key here hands every visitor admin over the project.
VITE_SUPABASE_KEY=
