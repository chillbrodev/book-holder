{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read=../.env --allow-sys=osRelease src/main.ts",
    "production": "deno run --allow-net --allow-env --allow-sys=osRelease src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read=../.env --allow-sys=osRelease src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read=../.env --allow-sys=osRelease",
    "warm-polly-cache": "deno run --allow-net --allow-env --allow-read=../.env --allow-sys=osRelease src/scripts/warmPollyCache.ts",
    "test-polly-line": "deno run --allow-net --allow-env --allow-read=../.env --allow-sys=osRelease src/scripts/testPollyLine.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono",
    "hono/cors": "jsr:@hono/hono/cors",
    "hono/cookie": "jsr:@hono/hono/cookie",
    "hono/http-exception": "jsr:@hono/hono/http-exception",
    "hono/utils/types": "jsr:@hono/hono/utils/types",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@0",
    "@std/fmt": "jsr:@std/fmt@1",
    "pg": "npm:pg@^8.13.0",
    "@aws-sdk/client-polly": "npm:@aws-sdk/client-polly@^3",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3",
    "@aws-sdk/s3-request-presigner": "npm:@aws-sdk/s3-request-presigner@^3"
  }
}
